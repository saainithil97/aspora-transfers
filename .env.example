# Copy to .env; the Makefile exports every line here into make targets.
DATABASE_URL=jdbc:postgresql://localhost:5432/transfers
DATABASE_USER=transfers
DATABASE_PASSWORD=transfers
PORT=8080
RAIL_FAILURE_RATE=0.2
RAIL_LATENCY_MS=300
RAIL_WEBHOOK_SECRET=rail-dev-secret
RAIL_WEBHOOK_ENABLED=true
RAIL_WEBHOOK_DROP_RATE=0.02
RAIL_LOOKUP_FAILURE_RATE=0.0
RECONCILE_INTERVAL_MS=5000
RECONCILE_GRACE_MS=30000
DISPATCH_INTERVAL_MS=500
DAILY_LIMIT_MINOR=5000000
# Host port the compose Postgres is published on. Change it (and DATABASE_URL) if 5432 is already taken.
PG_PORT=5432
